diff --git a/ui/wasm.c b/ui/wasm.c
new file mode 100644
index 0000000..19776c6
--- /dev/null
+++ b/ui/wasm.c
@@ -0,0 +1,209 @@
+/*
+ * Browser display for QEMU Wasm (vnvm).
+ *
+ * The page's main thread presents the guest framebuffer with WebGPU and feeds
+ * input back. Everything is exchanged through a small struct in the shared
+ * wasm heap, so no calls cross threads per frame:
+ *
+ *  - QEMU publishes the surface pointer/size and a dirty rectangle, then bumps
+ *    `seq`. The page polls `seq` on requestAnimationFrame and uploads only the
+ *    dirty rows.
+ *  - The page appends input events to a ring; QEMU drains it on each refresh.
+ *
+ * Copyright (c) 2026 vnvm authors
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/main-loop.h"
+#include "ui/console.h"
+#include "ui/input.h"
+#include "ui/surface.h"
+#include "sysemu/sysemu.h"
+#include "sysemu/runstate.h"
+#include <emscripten.h>
+
+#define VNVM_INPUT_RING 256
+
+enum {
+    VNVM_EV_KEY = 1,      /* a = linux keycode, b = down */
+    VNVM_EV_ABS = 2,      /* a = x, b = y, in surface pixels */
+    VNVM_EV_BTN = 3,      /* a = InputButton, b = down */
+    VNVM_EV_WHEEL = 4,    /* a = dy (+1 down / -1 up) */
+    VNVM_EV_REL = 5,      /* a = dx, b = dy */
+};
+
+typedef struct VnvmEvent {
+    int32_t type, a, b, c;
+} VnvmEvent;
+
+/* Layout is mirrored in web/src/display.ts; keep both in sync. */
+typedef struct VnvmShared {
+    uint32_t magic;          /* 'VNVM' */
+    uint32_t seq;            /* bumped after every publish */
+    uint32_t data;           /* surface pixels (heap offset) */
+    int32_t width, height, stride;
+    uint32_t format;         /* pixman format code */
+    int32_t dx0, dy0, dx1, dy1; /* dirty rect, exclusive end; dx1 == 0: none */
+    uint32_t refresh_ms;
+    uint32_t in_head;        /* written by the page */
+    uint32_t in_tail;        /* written by QEMU */
+    VnvmEvent ring[VNVM_INPUT_RING];
+    /* statistics for the page's overlay */
+    uint32_t frames;
+    uint32_t guest_running;
+} VnvmShared;
+
+static VnvmShared *shared;
+static DisplayChangeListener *dcl;
+static DisplaySurface *surface;
+static int dirty_x0, dirty_y0, dirty_x1, dirty_y1;
+
+static void dirty_reset(void)
+{
+    dirty_x0 = dirty_y0 = INT_MAX;
+    dirty_x1 = dirty_y1 = 0;
+}
+
+static void wasm_gfx_update(DisplayChangeListener *l, int x, int y, int w, int h)
+{
+    dirty_x0 = MIN(dirty_x0, x);
+    dirty_y0 = MIN(dirty_y0, y);
+    dirty_x1 = MAX(dirty_x1, x + w);
+    dirty_y1 = MAX(dirty_y1, y + h);
+}
+
+static void wasm_gfx_switch(DisplayChangeListener *l, DisplaySurface *s)
+{
+    surface = s;
+    if (!s) {
+        return;
+    }
+    wasm_gfx_update(l, 0, 0, surface_width(s), surface_height(s));
+}
+
+static bool wasm_check_format(DisplayChangeListener *l, pixman_format_code_t f)
+{
+    /* The page uploads as bgra8unorm. */
+    return f == PIXMAN_x8r8g8b8 || f == PIXMAN_a8r8g8b8;
+}
+
+static void drain_input(void)
+{
+    uint32_t head = qatomic_load_acquire(&shared->in_head);
+    uint32_t tail = shared->in_tail;
+    bool abs = false;
+
+    while (tail != head) {
+        VnvmEvent *e = &shared->ring[tail % VNVM_INPUT_RING];
+        switch (e->type) {
+        case VNVM_EV_KEY: {
+            int q = qemu_input_linux_to_qcode(e->a);
+            if (q) {
+                qemu_input_event_send_key_qcode(NULL, q, e->b);
+            }
+            break;
+        }
+        case VNVM_EV_ABS:
+            if (surface) {
+                qemu_input_queue_abs(NULL, INPUT_AXIS_X, e->a, 0, surface_width(surface));
+                qemu_input_queue_abs(NULL, INPUT_AXIS_Y, e->b, 0, surface_height(surface));
+                abs = true;
+            }
+            break;
+        case VNVM_EV_REL:
+            qemu_input_queue_rel(NULL, INPUT_AXIS_X, e->a);
+            qemu_input_queue_rel(NULL, INPUT_AXIS_Y, e->b);
+            abs = true;
+            break;
+        case VNVM_EV_BTN:
+            qemu_input_queue_btn(NULL, e->a, e->b);
+            qemu_input_event_sync();
+            break;
+        case VNVM_EV_WHEEL: {
+            InputButton b = e->a > 0 ? INPUT_BUTTON_WHEEL_DOWN : INPUT_BUTTON_WHEEL_UP;
+            qemu_input_queue_btn(NULL, b, true);
+            qemu_input_event_sync();
+            qemu_input_queue_btn(NULL, b, false);
+            qemu_input_event_sync();
+            break;
+        }
+        }
+        tail++;
+    }
+    if (abs) {
+        qemu_input_event_sync();
+    }
+    qatomic_store_release(&shared->in_tail, tail);
+}
+
+static void wasm_refresh(DisplayChangeListener *l)
+{
+    drain_input();
+    graphic_hw_update(l->con);
+    shared->guest_running = runstate_is_running();
+    if (!surface || dirty_x1 == 0) {
+        return;
+    }
+    shared->data = (uint32_t)(uintptr_t)surface_data(surface);
+    shared->width = surface_width(surface);
+    shared->height = surface_height(surface);
+    shared->stride = surface_stride(surface);
+    shared->format = surface_format(surface);
+    /* Merge with a rect the page has not consumed yet. */
+    if (shared->dx1 != 0) {
+        dirty_x0 = MIN(dirty_x0, shared->dx0);
+        dirty_y0 = MIN(dirty_y0, shared->dy0);
+        dirty_x1 = MAX(dirty_x1, shared->dx1);
+        dirty_y1 = MAX(dirty_y1, shared->dy1);
+    }
+    shared->dx0 = MAX(dirty_x0, 0);
+    shared->dy0 = MAX(dirty_y0, 0);
+    shared->dx1 = MIN(dirty_x1, shared->width);
+    shared->dy1 = MIN(dirty_y1, shared->height);
+    shared->frames++;
+    qatomic_store_release(&shared->seq, shared->seq + 1);
+    dirty_reset();
+}
+
+static const DisplayChangeListenerOps wasm_ops = {
+    .dpy_name = "wasm",
+    .dpy_gfx_update = wasm_gfx_update,
+    .dpy_gfx_switch = wasm_gfx_switch,
+    .dpy_gfx_check_format = wasm_check_format,
+    .dpy_refresh = wasm_refresh,
+};
+
+static void wasm_display_init(DisplayState *ds, DisplayOptions *opts)
+{
+    const char *ms = getenv("VNVM_REFRESH_MS");
+
+    shared = g_malloc0(sizeof(*shared));
+    shared->magic = 0x4d564e56;
+    shared->refresh_ms = ms ? atoi(ms) : 16;
+    dirty_reset();
+
+    dcl = g_new0(DisplayChangeListener, 1);
+    dcl->ops = &wasm_ops;
+    register_displaychangelistener(dcl);
+    update_displaychangelistener(dcl, shared->refresh_ms);
+
+    /* Hand the struct to the page (runs on the browser main thread). */
+    MAIN_THREAD_EM_ASM({
+        if (Module.onVnvmDisplay) {
+            Module.onVnvmDisplay($0, $1);
+        }
+    }, shared, VNVM_INPUT_RING);
+}
+
+static QemuDisplay qemu_display_wasm = {
+    .type = DISPLAY_TYPE_WASM,
+    .init = wasm_display_init,
+};
+
+static void register_wasm(void)
+{
+    qemu_display_register(&qemu_display_wasm);
+}
+
+type_init(register_wasm);
diff --git a/util/event_notifier-wasm.c b/util/event_notifier-wasm.c
new file mode 100644
index 0000000..df04e94
--- /dev/null
+++ b/util/event_notifier-wasm.c
@@ -0,0 +1,167 @@
+/*
+ * vnvm: event notifiers and the main-loop wait without file descriptors.
+ *
+ * Under emscripten every fd syscall (pipe writes, poll) is proxied to the
+ * browser's main thread, poll never sleeps, and so QEMU's main loop spins
+ * through proxied calls while the vCPU blocks on the BQL for each wakeup.
+ * Here a notifier is a flag word; a pseudo fd (>= VNVM_FD_BASE) stands in for
+ * it in GPollFD arrays, and qemu_poll_ns waits on one futex instead.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/cutils.h"
+#include "qemu/event_notifier.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include <emscripten/threading.h>
+
+#define VNVM_FD_BASE 0x40000000
+#define VNVM_NOTIFIERS 4096
+
+static uint32_t notifier_flag[VNVM_NOTIFIERS];
+static uint8_t notifier_used[VNVM_NOTIFIERS];
+static QemuMutex alloc_lock;
+static uint32_t poll_seq; /* bumped on every set; the futex word */
+
+static void __attribute__((constructor)) init_lock(void)
+{
+    qemu_mutex_init(&alloc_lock);
+}
+
+static inline bool is_pseudo(int fd)
+{
+    return fd >= VNVM_FD_BASE && fd < VNVM_FD_BASE + VNVM_NOTIFIERS;
+}
+
+void event_notifier_init_fd(EventNotifier *e, int fd)
+{
+    e->rfd = fd;
+    e->wfd = fd;
+    e->initialized = true;
+}
+
+int event_notifier_init(EventNotifier *e, int active)
+{
+    qemu_mutex_lock(&alloc_lock);
+    for (int i = 0; i < VNVM_NOTIFIERS; i++) {
+        if (!notifier_used[i]) {
+            notifier_used[i] = 1;
+            qemu_mutex_unlock(&alloc_lock);
+            qatomic_set(&notifier_flag[i], active ? 1 : 0);
+            e->rfd = e->wfd = VNVM_FD_BASE + i;
+            e->initialized = true;
+            return 0;
+        }
+    }
+    qemu_mutex_unlock(&alloc_lock);
+    return -ENOMEM;
+}
+
+void event_notifier_cleanup(EventNotifier *e)
+{
+    if (is_pseudo(e->rfd)) {
+        qemu_mutex_lock(&alloc_lock);
+        notifier_used[e->rfd - VNVM_FD_BASE] = 0;
+        qemu_mutex_unlock(&alloc_lock);
+    } else if (e->rfd >= 0) {
+        close(e->rfd);
+    }
+    e->rfd = -1;
+    e->wfd = -1;
+    e->initialized = false;
+}
+
+int event_notifier_get_fd(const EventNotifier *e)
+{
+    return e->rfd;
+}
+
+int event_notifier_get_wfd(const EventNotifier *e)
+{
+    return e->wfd;
+}
+
+int event_notifier_set(EventNotifier *e)
+{
+    if (!e->initialized) {
+        return -ENOENT;
+    }
+    if (is_pseudo(e->wfd)) {
+        qatomic_set(&notifier_flag[e->wfd - VNVM_FD_BASE], 1);
+        qatomic_inc(&poll_seq);
+        emscripten_futex_wake(&poll_seq, INT_MAX);
+        return 0;
+    }
+    static const uint64_t value = 1;
+    while (write(e->wfd, &value, sizeof(value)) < 0 && errno == EINTR) {
+    }
+    return 0;
+}
+
+int event_notifier_test_and_clear(EventNotifier *e)
+{
+    if (!e->initialized) {
+        return 0;
+    }
+    if (is_pseudo(e->rfd)) {
+        return qatomic_xchg(&notifier_flag[e->rfd - VNVM_FD_BASE], 0) != 0;
+    }
+    int value = 0;
+    char buffer[512];
+    ssize_t len;
+    do {
+        len = read(e->rfd, buffer, sizeof(buffer));
+        value |= (len > 0);
+    } while ((len == -1 && errno == EINTR) || len == sizeof(buffer));
+    return value;
+}
+
+/* qemu_poll_ns for the wasm build (util/qemu-timer.c calls it). */
+int vnvm_poll_ns(GPollFD *fds, guint nfds, int64_t timeout)
+{
+    int64_t deadline = timeout < 0 ? -1 : qemu_clock_get_ns(QEMU_CLOCK_REALTIME) + timeout;
+    GPollFD real[64];
+    int real_idx[64];
+
+    for (;;) {
+        uint32_t seq = qatomic_read(&poll_seq);
+        int ready = 0, nreal = 0;
+        for (guint i = 0; i < nfds; i++) {
+            fds[i].revents = 0;
+            if (is_pseudo(fds[i].fd)) {
+                if ((fds[i].events & G_IO_IN) &&
+                    qatomic_read(&notifier_flag[fds[i].fd - VNVM_FD_BASE])) {
+                    fds[i].revents = G_IO_IN;
+                    ready++;
+                }
+            } else if (nreal < 64) {
+                real[nreal] = fds[i];
+                real_idx[nreal++] = i;
+            }
+        }
+        if (nreal) {
+            /* Real fds (the signal pipe) are asked once per wakeup, never slept on. */
+            int n = g_poll(real, nreal, 0);
+            if (n > 0) {
+                for (int i = 0; i < nreal; i++) {
+                    fds[real_idx[i]].revents = real[i].revents;
+                }
+                ready += n;
+            }
+        }
+        if (ready || timeout == 0) {
+            return ready;
+        }
+        double wait_ms = nreal ? 50 : 1000;
+        if (deadline >= 0) {
+            int64_t left = deadline - qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+            if (left <= 0) {
+                return 0;
+            }
+            wait_ms = MIN(wait_ms, left / 1e6);
+        }
+        emscripten_futex_wait(&poll_seq, seq, wait_ms);
+    }
+}
