+/*
+ * vnvm: function header + prologue. Locals: $ctx (param), 2 x i32, 5 x i64
+ * temporaries, then the TCG registers R0..R15 and the block pointer
+ * (REG_LOCAL_BASE..). env/stack are loaded on every entry; on an Asyncify
+ * rewind (do_init == 0) the registers come back from ctx->spill.
+ */
+#define HEADER_D_MAX 256
+static int build_header_d(uint8_t *p)
+{
+    uint8_t *q = p;
+    static const uint8_t sec[] = {
+        0x0a, 0x80, 0x80, 0x80, 0x80, 0x00,
+        0x80, 0x80, 0x80, 0x80, 0x00,
+        0x80, 0x80, 0x80, 0x80, 0x00,
+    };
+    memcpy(q, sec, sizeof(sec));
+    q += sizeof(sec);
+    /*
+     * Locals: 1 env32, 2 tmp32, 3-7 tmp64, 8-24 TCG registers R0..R15 and
+     * the block pointer (REG_LOCAL_BASE), 25 env32 - ENVM_BIAS (negative
+     * env offsets become positive), 26 tmp32.
+     */
+    *q++ = 4;
+    *q++ = 2; *q++ = 0x7f;
+    *q++ = 5; *q++ = 0x7e;
+    *q++ = 17; *q++ = 0x7e;
+    *q++ = 2; *q++ = 0x7f;
+    /* ctx->tb_count++ */
+    *q++ = 0x20; *q++ = 0; *q++ = 0x20; *q++ = 0;
+    *q++ = 0x29; *q++ = 3; q += write_uint32_leb128((uintptr_t)q, TB_COUNT_OFF);
+    *q++ = 0x42; *q++ = 1; *q++ = 0x7c;
+    *q++ = 0x37; *q++ = 3; q += write_uint32_leb128((uintptr_t)q, TB_COUNT_OFF);
+    /* env -> local 1 (i32), R14 (i64), local 25 (i32, biased) */
+    *q++ = 0x20; *q++ = 0; *q++ = 0x28; *q++ = 2; *q++ = ENV_OFF;
+    *q++ = 0x22; *q++ = 1;
+    *q++ = 0xad; *q++ = 0x21; *q++ = 8 + 14;
+    *q++ = 0x20; *q++ = 1; *q++ = 0x41; q += write_sint32_leb128((uintptr_t)q, ENVM_BIAS);
+    *q++ = 0x6b; *q++ = 0x21; *q++ = 25;
+    /* stack -> R15 */
+    *q++ = 0x20; *q++ = 0; *q++ = 0x28; *q++ = 2; *q++ = STACK_OFF;
+    *q++ = 0xad; *q++ = 0x21; *q++ = 8 + 15;
+    /* loop; if (block_ptr == 0) */
+    *q++ = 0x03; *q++ = 0x40;
+    *q++ = 0x20; *q++ = 8 + 16; *q++ = 0x50;
+    *q++ = 0x04; *q++ = 0x40;
+    tcg_debug_assert(q - p <= HEADER_D_MAX);
+    return q - p;
+}
 
