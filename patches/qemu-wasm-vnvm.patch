diff --git a/block/vnvm.c b/block/vnvm.c
new file mode 100644
index 0000000..03cc4c9
--- /dev/null
+++ b/block/vnvm.c
@@ -0,0 +1,220 @@
+/*
+ * Streaming disk for QEMU Wasm (vnvm).
+ *
+ *   -drive if=none,id=root,driver=vnvm,url=https://host/disks/root/manifest.json
+ *
+ * The image is a set of content-addressed chunks described by a manifest
+ * (see crates/vnvm-pack). Chunks are fetched on first read, so only the blocks
+ * the guest touches cross the network; the browser's HTTP cache (chunks are
+ * immutable) keeps them for the next run. Writes stay in a copy-on-write
+ * overlay in the wasm heap, at 4KiB granularity.
+ *
+ * Fetching is done by JS in this (the QEMU main loop's) worker: see
+ * web/src/vnvm-disk.js, which this file calls through Module.vnvmDisk.
+ *
+ * Copyright (c) 2026 vnvm authors
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "block/block_int.h"
+#include "qapi/error.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qstring.h"
+#include "qemu/module.h"
+#include "qemu/option.h"
+#include "qemu/cutils.h"
+#include <emscripten.h>
+
+#define VNVM_BLOCK 4096
+
+typedef struct BDRVVnvmState {
+    int id;
+    int64_t length;
+    GHashTable *overlay; /* block index -> 4KiB buffer */
+    uint64_t overlay_bytes;
+} BDRVVnvmState;
+
+/* Returns a disk id >= 0, or -1. The size is stored at *size. */
+EM_JS(int, vnvm_js_open, (const char *url, double *size), {
+    try {
+        const d = globalThis.vnvmDiskOpen(UTF8ToString(url));
+        HEAPF64[size >> 3] = d.size;
+        return d.id;
+    } catch (e) {
+        console.error("vnvm: open failed", e);
+        return -1;
+    }
+});
+
+/* Reads [offset, offset + len) into dst. Returns 0 or -errno. */
+EM_JS(int, vnvm_js_read, (int id, double offset, int len, uint8_t *dst), {
+    try {
+        globalThis.vnvmDiskRead(id, offset, len, HEAPU8, dst);
+        return 0;
+    } catch (e) {
+        console.error("vnvm: read failed", e);
+        return -5;
+    }
+});
+
+static QemuOptsList runtime_opts = {
+    .name = "vnvm",
+    .head = QTAILQ_HEAD_INITIALIZER(runtime_opts.head),
+    .desc = {
+        { .name = "url", .type = QEMU_OPT_STRING, .help = "manifest URL" },
+        { /* end of list */ }
+    },
+};
+
+static void vnvm_parse_filename(const char *filename, QDict *options, Error **errp)
+{
+    if (strstart(filename, "vnvm:", &filename)) {
+        qdict_put_str(options, "url", filename);
+    }
+}
+
+static int vnvm_open(BlockDriverState *bs, QDict *options, int flags, Error **errp)
+{
+    BDRVVnvmState *s = bs->opaque;
+    QemuOpts *opts = qemu_opts_create(&runtime_opts, NULL, 0, &error_abort);
+    double size = 0;
+    const char *url;
+    int ret = 0;
+
+    qemu_opts_absorb_qdict(opts, options, &error_abort);
+    url = qemu_opt_get(opts, "url");
+    if (!url) {
+        error_setg(errp, "vnvm: url is required");
+        ret = -EINVAL;
+        goto out;
+    }
+    s->id = vnvm_js_open(url, &size);
+    if (s->id < 0) {
+        error_setg(errp, "vnvm: cannot open %s", url);
+        ret = -EIO;
+        goto out;
+    }
+    s->length = (int64_t)size;
+    s->overlay = g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, g_free);
+out:
+    qemu_opts_del(opts);
+    return ret;
+}
+
+static void vnvm_close(BlockDriverState *bs)
+{
+    BDRVVnvmState *s = bs->opaque;
+    g_hash_table_destroy(s->overlay);
+}
+
+static void vnvm_refresh_limits(BlockDriverState *bs, Error **errp)
+{
+    bs->bl.request_alignment = VNVM_BLOCK;
+}
+
+static int64_t coroutine_fn vnvm_getlength(BlockDriverState *bs)
+{
+    BDRVVnvmState *s = bs->opaque;
+    return s->length;
+}
+
+static int coroutine_fn vnvm_co_preadv(BlockDriverState *bs, int64_t offset, int64_t bytes,
+                                       QEMUIOVector *qiov, BdrvRequestFlags flags)
+{
+    BDRVVnvmState *s = bs->opaque;
+    g_autofree uint8_t *buf = g_malloc(bytes);
+    int64_t run_start = -1;
+
+    /* Fetch maximal runs of blocks that are not in the overlay in one call. */
+    for (int64_t pos = 0; pos <= bytes; pos += VNVM_BLOCK) {
+        uint8_t *ov = NULL;
+        if (pos < bytes) {
+            int64_t idx = (offset + pos) / VNVM_BLOCK;
+            ov = g_hash_table_lookup(s->overlay, &idx);
+        }
+        if ((ov || pos == bytes) && run_start >= 0) {
+            int ret = vnvm_js_read(s->id, offset + run_start, pos - run_start, buf + run_start);
+            if (ret < 0) {
+                return ret;
+            }
+            run_start = -1;
+        }
+        if (pos == bytes) {
+            break;
+        }
+        if (ov) {
+            memcpy(buf + pos, ov, VNVM_BLOCK);
+        } else if (run_start < 0) {
+            run_start = pos;
+        }
+    }
+    qemu_iovec_from_buf(qiov, 0, buf, bytes);
+    return 0;
+}
+
+static int coroutine_fn vnvm_co_pwritev(BlockDriverState *bs, int64_t offset, int64_t bytes,
+                                        QEMUIOVector *qiov, BdrvRequestFlags flags)
+{
+    BDRVVnvmState *s = bs->opaque;
+
+    for (int64_t pos = 0; pos < bytes; pos += VNVM_BLOCK) {
+        int64_t idx = (offset + pos) / VNVM_BLOCK;
+        uint8_t *ov = g_hash_table_lookup(s->overlay, &idx);
+        if (!ov) {
+            int64_t *key = g_new(int64_t, 1);
+            *key = idx;
+            ov = g_malloc(VNVM_BLOCK);
+            g_hash_table_insert(s->overlay, key, ov);
+            s->overlay_bytes += VNVM_BLOCK;
+        }
+        qemu_iovec_to_buf(qiov, pos, ov, VNVM_BLOCK);
+    }
+    return 0;
+}
+
+static int coroutine_fn vnvm_co_flush(BlockDriverState *bs)
+{
+    return 0;
+}
+
+static int coroutine_fn vnvm_co_block_status(BlockDriverState *bs, bool want_zero,
+                                             int64_t offset, int64_t bytes, int64_t *pnum,
+                                             int64_t *map, BlockDriverState **file)
+{
+    *pnum = bytes;
+    *map = offset;
+    *file = bs;
+    return BDRV_BLOCK_DATA | BDRV_BLOCK_OFFSET_VALID;
+}
+
+static int vnvm_reopen_prepare(BDRVReopenState *st, BlockReopenQueue *q, Error **errp)
+{
+    return 0;
+}
+
+static const char *const vnvm_strong_runtime_opts[] = { "url", NULL };
+
+static BlockDriver bdrv_vnvm = {
+    .format_name = "vnvm",
+    .protocol_name = "vnvm",
+    .instance_size = sizeof(BDRVVnvmState),
+    .bdrv_file_open = vnvm_open,
+    .bdrv_close = vnvm_close,
+    .bdrv_parse_filename = vnvm_parse_filename,
+    .bdrv_refresh_limits = vnvm_refresh_limits,
+    .bdrv_co_getlength = vnvm_getlength,
+    .bdrv_co_preadv = vnvm_co_preadv,
+    .bdrv_co_pwritev = vnvm_co_pwritev,
+    .bdrv_co_flush_to_disk = vnvm_co_flush,
+    .bdrv_co_block_status = vnvm_co_block_status,
+    .bdrv_reopen_prepare = vnvm_reopen_prepare,
+    .strong_runtime_opts = vnvm_strong_runtime_opts,
+};
+
+static void bdrv_vnvm_init(void)
+{
+    bdrv_register(&bdrv_vnvm);
+}
+
+block_init(bdrv_vnvm_init);
