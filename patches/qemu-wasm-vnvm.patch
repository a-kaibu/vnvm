diff --git a/audio/wasmaudio.c b/audio/wasmaudio.c
new file mode 100644
index 0000000..18ff9d1
--- /dev/null
+++ b/audio/wasmaudio.c
@@ -0,0 +1,140 @@
+/*
+ * Browser audio output for QEMU Wasm (vnvm).
+ *
+ * Guest audio is mixed to 48kHz stereo S16 and written into a ring in the
+ * shared wasm heap. An AudioWorklet on the page drains it. The ring's free
+ * space is what QEMU reports to the device model, so the guest is paced by
+ * the browser's audio clock instead of a QEMU timer.
+ *
+ * Copyright (c) 2026 vnvm authors
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "audio.h"
+#include <emscripten.h>
+
+#define AUDIO_CAP "wasm"
+#include "audio_int.h"
+
+#define RING_FRAMES 16384 /* ~340ms at 48kHz; must be a power of two */
+
+/* Layout is mirrored in web/src/audio.ts; keep both in sync. */
+typedef struct WasmAudioShared {
+    uint32_t magic;      /* 'VNVA' */
+    uint32_t rate;
+    uint32_t channels;
+    uint32_t frames;     /* ring size in frames */
+    uint32_t write_pos;  /* frames written by QEMU (wraps at 2^32) */
+    uint32_t read_pos;   /* frames consumed by the worklet */
+    uint32_t enabled;
+    uint32_t underruns;  /* counted by the worklet */
+    int16_t ring[RING_FRAMES * 2];
+} WasmAudioShared;
+
+typedef struct WasmVoiceOut {
+    HWVoiceOut hw;
+} WasmVoiceOut;
+
+static WasmAudioShared *shared;
+
+static size_t ring_free_bytes(void)
+{
+    uint32_t used = shared->write_pos - qatomic_load_acquire(&shared->read_pos);
+    if (used > RING_FRAMES) {
+        used = RING_FRAMES;
+    }
+    return (RING_FRAMES - used) * 4;
+}
+
+static size_t wasm_buffer_get_free(HWVoiceOut *hw)
+{
+    return MIN(ring_free_bytes(), hw->samples * hw->info.bytes_per_frame);
+}
+
+static size_t wasm_write(HWVoiceOut *hw, void *buf, size_t len)
+{
+    size_t frames = MIN(len, ring_free_bytes()) / 4;
+    uint32_t pos = shared->write_pos;
+    const int16_t *src = buf;
+
+    for (size_t i = 0; i < frames; i++) {
+        uint32_t at = (pos + i) & (RING_FRAMES - 1);
+        shared->ring[at * 2] = src[i * 2];
+        shared->ring[at * 2 + 1] = src[i * 2 + 1];
+    }
+    qatomic_store_release(&shared->write_pos, pos + frames);
+    return frames * 4;
+}
+
+static int wasm_init_out(HWVoiceOut *hw, struct audsettings *as, void *drv_opaque)
+{
+    struct audsettings obt = {
+        .freq = 48000,
+        .nchannels = 2,
+        .fmt = AUDIO_FORMAT_S16,
+        .endianness = 0,
+    };
+
+    audio_pcm_init_info(&hw->info, &obt);
+    hw->samples = 1024;
+    return 0;
+}
+
+static void wasm_fini_out(HWVoiceOut *hw)
+{
+}
+
+static void wasm_enable_out(HWVoiceOut *hw, bool enable)
+{
+    shared->enabled = enable;
+}
+
+static void *wasm_audio_init(Audiodev *dev, Error **errp)
+{
+    if (!shared) {
+        shared = g_malloc0(sizeof(*shared));
+        shared->magic = 0x41564e56;
+        shared->rate = 48000;
+        shared->channels = 2;
+        shared->frames = RING_FRAMES;
+        MAIN_THREAD_EM_ASM({
+            if (Module.onVnvmAudio) {
+                Module.onVnvmAudio($0);
+            }
+        }, shared);
+    }
+    return shared;
+}
+
+static void wasm_audio_fini(void *opaque)
+{
+}
+
+static struct audio_pcm_ops wasm_pcm_ops = {
+    .init_out = wasm_init_out,
+    .fini_out = wasm_fini_out,
+    .write = wasm_write,
+    .buffer_get_free = wasm_buffer_get_free,
+    .run_buffer_out = audio_generic_run_buffer_out,
+    .enable_out = wasm_enable_out,
+};
+
+static struct audio_driver wasm_audio_driver = {
+    .name = "wasm",
+    .descr = "Browser AudioWorklet output",
+    .init = wasm_audio_init,
+    .fini = wasm_audio_fini,
+    .pcm_ops = &wasm_pcm_ops,
+    .max_voices_out = 1,
+    .max_voices_in = 0,
+    .voice_size_out = sizeof(WasmVoiceOut),
+    .voice_size_in = 0,
+};
+
+static void register_audio_wasm(void)
+{
+    audio_driver_register(&wasm_audio_driver);
+}
+type_init(register_audio_wasm);
