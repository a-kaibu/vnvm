diff --git a/util/event_notifier-wasm.c b/util/event_notifier-wasm.c
new file mode 100644
index 0000000..df04e94
--- /dev/null
+++ b/util/event_notifier-wasm.c
@@ -0,0 +1,167 @@
+/*
+ * vnvm: event notifiers and the main-loop wait without file descriptors.
+ *
+ * Under emscripten every fd syscall (pipe writes, poll) is proxied to the
+ * browser's main thread, poll never sleeps, and so QEMU's main loop spins
+ * through proxied calls while the vCPU blocks on the BQL for each wakeup.
+ * Here a notifier is a flag word; a pseudo fd (>= VNVM_FD_BASE) stands in for
+ * it in GPollFD arrays, and qemu_poll_ns waits on one futex instead.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/cutils.h"
+#include "qemu/event_notifier.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include <emscripten/threading.h>
+
+#define VNVM_FD_BASE 0x40000000
+#define VNVM_NOTIFIERS 4096
+
+static uint32_t notifier_flag[VNVM_NOTIFIERS];
+static uint8_t notifier_used[VNVM_NOTIFIERS];
+static QemuMutex alloc_lock;
+static uint32_t poll_seq; /* bumped on every set; the futex word */
+
+static void __attribute__((constructor)) init_lock(void)
+{
+    qemu_mutex_init(&alloc_lock);
+}
+
+static inline bool is_pseudo(int fd)
+{
+    return fd >= VNVM_FD_BASE && fd < VNVM_FD_BASE + VNVM_NOTIFIERS;
+}
+
+void event_notifier_init_fd(EventNotifier *e, int fd)
+{
+    e->rfd = fd;
+    e->wfd = fd;
+    e->initialized = true;
+}
+
+int event_notifier_init(EventNotifier *e, int active)
+{
+    qemu_mutex_lock(&alloc_lock);
+    for (int i = 0; i < VNVM_NOTIFIERS; i++) {
+        if (!notifier_used[i]) {
+            notifier_used[i] = 1;
+            qemu_mutex_unlock(&alloc_lock);
+            qatomic_set(&notifier_flag[i], active ? 1 : 0);
+            e->rfd = e->wfd = VNVM_FD_BASE + i;
+            e->initialized = true;
+            return 0;
+        }
+    }
+    qemu_mutex_unlock(&alloc_lock);
+    return -ENOMEM;
+}
+
+void event_notifier_cleanup(EventNotifier *e)
+{
+    if (is_pseudo(e->rfd)) {
+        qemu_mutex_lock(&alloc_lock);
+        notifier_used[e->rfd - VNVM_FD_BASE] = 0;
+        qemu_mutex_unlock(&alloc_lock);
+    } else if (e->rfd >= 0) {
+        close(e->rfd);
+    }
+    e->rfd = -1;
+    e->wfd = -1;
+    e->initialized = false;
+}
+
+int event_notifier_get_fd(const EventNotifier *e)
+{
+    return e->rfd;
+}
+
+int event_notifier_get_wfd(const EventNotifier *e)
+{
+    return e->wfd;
+}
+
+int event_notifier_set(EventNotifier *e)
+{
+    if (!e->initialized) {
+        return -ENOENT;
+    }
+    if (is_pseudo(e->wfd)) {
+        qatomic_set(&notifier_flag[e->wfd - VNVM_FD_BASE], 1);
+        qatomic_inc(&poll_seq);
+        emscripten_futex_wake(&poll_seq, INT_MAX);
+        return 0;
+    }
+    static const uint64_t value = 1;
+    while (write(e->wfd, &value, sizeof(value)) < 0 && errno == EINTR) {
+    }
+    return 0;
+}
+
+int event_notifier_test_and_clear(EventNotifier *e)
+{
+    if (!e->initialized) {
+        return 0;
+    }
+    if (is_pseudo(e->rfd)) {
+        return qatomic_xchg(&notifier_flag[e->rfd - VNVM_FD_BASE], 0) != 0;
+    }
+    int value = 0;
+    char buffer[512];
+    ssize_t len;
+    do {
+        len = read(e->rfd, buffer, sizeof(buffer));
+        value |= (len > 0);
+    } while ((len == -1 && errno == EINTR) || len == sizeof(buffer));
+    return value;
+}
+
+/* qemu_poll_ns for the wasm build (util/qemu-timer.c calls it). */
+int vnvm_poll_ns(GPollFD *fds, guint nfds, int64_t timeout)
+{
+    int64_t deadline = timeout < 0 ? -1 : qemu_clock_get_ns(QEMU_CLOCK_REALTIME) + timeout;
+    GPollFD real[64];
+    int real_idx[64];
+
+    for (;;) {
+        uint32_t seq = qatomic_read(&poll_seq);
+        int ready = 0, nreal = 0;
+        for (guint i = 0; i < nfds; i++) {
+            fds[i].revents = 0;
+            if (is_pseudo(fds[i].fd)) {
+                if ((fds[i].events & G_IO_IN) &&
+                    qatomic_read(&notifier_flag[fds[i].fd - VNVM_FD_BASE])) {
+                    fds[i].revents = G_IO_IN;
+                    ready++;
+                }
+            } else if (nreal < 64) {
+                real[nreal] = fds[i];
+                real_idx[nreal++] = i;
+            }
+        }
+        if (nreal) {
+            /* Real fds (the signal pipe) are asked once per wakeup, never slept on. */
+            int n = g_poll(real, nreal, 0);
+            if (n > 0) {
+                for (int i = 0; i < nreal; i++) {
+                    fds[real_idx[i]].revents = real[i].revents;
+                }
+                ready += n;
+            }
+        }
+        if (ready || timeout == 0) {
+            return ready;
+        }
+        double wait_ms = nreal ? 50 : 1000;
+        if (deadline >= 0) {
+            int64_t left = deadline - qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+            if (left <= 0) {
+                return 0;
+            }
+            wait_ms = MIN(wait_ms, left / 1e6);
+        }
+        emscripten_futex_wait(&poll_seq, seq, wait_ms);
+    }
+}
