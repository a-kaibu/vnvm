 }
 
+static int write_sint32_leb128(uintptr_t bi, int32_t v) {
+    uint8_t *b = (uint8_t *)bi;
+    for (;;) {
+        uint8_t byte = v & 0x7f;
+        v >>= 7;
+        if ((v == 0 && !(byte & 0x40)) || (v == -1 && (byte & 0x40))) {
+            *b++ = byte;
+            break;
+        }
+        *b++ = byte | 0x80;
+    }
+    return (int)((uintptr_t)b - (uintptr_t)bi);
+}
+
