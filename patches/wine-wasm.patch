+/*
+ * wasm32 signal and syscall layer (vnvm Hangover-style runtime)
+ *
+ * The unix side of Wine is compiled to wasm32 with the i386 ABI; PE code runs in an x86 core
+ * (vnx86, linked from Rust as libvnhost) that shares the linear memory with us. PE code enters
+ * the unix side by jumping to trap addresses (see WASM_SYSCALL_TRAP), where the core stops and
+ * hands control back to the run loop below. The guest register state is kept in the syscall
+ * frame exactly like on i386, so the generic context, APC and exception code works unchanged.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#ifdef __wasm__
+
+#include "config.h"
+
+#include <assert.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "ddk/wdm.h"
+#include "wine/asm.h"
+#include "unix_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(seh);
+
+/* the x86 core (crates/vnhost) */
+struct vnhost_cpu;
+enum vnhost_exit { VNHOST_TRAP = 1, VNHOST_FAULT, VNHOST_DIVIDE, VNHOST_INVALID, VNHOST_INT, VNHOST_HALT, VNHOST_PENDING };
+enum { R_EAX, R_ECX, R_EDX, R_EBX, R_ESP, R_EBP, R_ESI, R_EDI, R_EIP, R_EFLAGS, R_COUNT };
+extern struct vnhost_cpu *vnhost_cpu_create( UINT trap_lo, UINT trap_hi );
+extern void vnhost_cpu_destroy( struct vnhost_cpu *cpu );
+extern void vnhost_cpu_get( struct vnhost_cpu *cpu, UINT regs[R_COUNT] );
+extern void vnhost_cpu_set( struct vnhost_cpu *cpu, const UINT regs[R_COUNT] );
+extern void vnhost_cpu_set_fs( struct vnhost_cpu *cpu, UINT base );
+extern void vnhost_cpu_fxsave( struct vnhost_cpu *cpu, void *dst );
+extern void vnhost_cpu_fxrstor( struct vnhost_cpu *cpu, const void *src );
+extern int vnhost_cpu_run( struct vnhost_cpu *cpu, UINT *info );
+extern void vnhost_cpuid( UINT leaf, UINT sub, UINT regs[4] );
+extern int vnhost_signal_pending( int sig );
+
+/* stack layout when calling KiUserExceptionDispatcher */
+struct exc_stack_layout
+{
+    EXCEPTION_RECORD *rec_ptr;       /* 000 first arg for KiUserExceptionDispatcher */
+    CONTEXT          *context_ptr;   /* 004 second arg for KiUserExceptionDispatcher */
+    EXCEPTION_RECORD  rec;           /* 008 */
+    CONTEXT           context;       /* 058 */
+    CONTEXT_EX        context_ex;    /* 324 */
+    DWORD             align;         /* 33c */
+};
+C_ASSERT( offsetof(struct exc_stack_layout, context) == 0x58 );
+C_ASSERT( sizeof(struct exc_stack_layout) == 0x340 );
+
+/* stack layout when calling KiUserApcDispatcher */
+struct apc_stack_layout
+{
+    PNTAPCFUNC        func;          /* 000 */
+    UINT              arg1;          /* 004 */
+    UINT              arg2;          /* 008 */
+    UINT              arg3;          /* 00c */
+    UINT              alertable;     /* 010 */
+    CONTEXT           context;       /* 014 */
+    CONTEXT_EX        xctx;          /* 2e0 */
+    UINT              unk2[4];       /* 2f8 */
+};
+C_ASSERT( offsetof(struct apc_stack_layout, context) == 0x14 );
+C_ASSERT( sizeof(struct apc_stack_layout) == 0x308 );
+
+/* stack layout when calling KiUserCallbackDispatcher */
+struct callback_stack_layout
+{
+    ULONG             eip;           /* 000 */
+    ULONG             id;            /* 004 */
+    void             *args;          /* 008 */
+    ULONG             len;           /* 00c */
+    ULONG             unk[2];        /* 010 */
+    ULONG             esp;           /* 018 */
+    BYTE              args_data[0];  /* 01c */
+};
+C_ASSERT( sizeof(struct callback_stack_layout) == 0x1c );
+
+struct syscall_frame
+{
+    UINT                  restore_flags;  /* 000 */
+    UINT                  eflags;         /* 004 */
+    UINT                  eip;            /* 008 */
+    UINT                  esp;            /* 00c */
+    WORD                  cs;             /* 010 */
+    WORD                  ss;             /* 012 */
+    WORD                  ds;             /* 014 */
+    WORD                  es;             /* 016 */
+    WORD                  fs;             /* 018 */
+    WORD                  gs;             /* 01a */
+    UINT                  eax;            /* 01c */
+    UINT                  ebx;            /* 020 */
+    UINT                  ecx;            /* 024 */
+    UINT                  edx;            /* 028 */
+    UINT                  edi;            /* 02c */
+    UINT                  esi;            /* 030 */
+    UINT                  ebp;            /* 034 */
+    void                 *syscall_cfa;    /* 038 */
+    struct syscall_frame *prev_frame;     /* 03c */
+    union                                 /* 040 */
+    {
+        XSAVE_FORMAT       xsave;
+        FLOATING_SAVE_AREA fsave;
+    } u;
+    DECLSPEC_ALIGN(64) XSAVE_AREA_HEADER xstate; /* 240 */
+};
+
+C_ASSERT( sizeof(struct syscall_frame) == 0x280 );
+
+#define RESTORE_FLAGS_INCOMPLETE_FRAME_CONTEXT 0x00008000
+
+struct x86_thread_data
+{
+    UINT               fs;            /* 1d4 TEB selector */
+    UINT               gs;            /* 1d8 libc selector; update winebuild if you move this! */
+    UINT               dr0;           /* 1dc debug registers */
+    UINT               dr1;           /* 1e0 */
+    UINT               dr2;           /* 1e4 */
+    UINT               dr3;           /* 1e8 */
+    UINT               dr6;           /* 1ec */
+    UINT               dr7;           /* 1f0 */
+    UINT               frame_size;    /* 1f4 syscall frame size including xstate */
+    UINT               fpcw;          /* 1f8 FPU control word */
+};
+
+C_ASSERT( sizeof(struct x86_thread_data) <= sizeof(((struct teb_data *)0)->cpu_data) );
+
+static inline struct x86_thread_data *x86_thread_data( struct thread_data *data )
+{
+    return (struct x86_thread_data *)get_teb_data( data )->cpu_data;
+}
+
+/* flat segments: values the guest sees in its segment registers */
+#define SEL_CS 0x23
+#define SEL_DS 0x2b
+#define SEL_FS 0x53
+
+static UINT frame_size;
+static UINT xstate_size;
+
+/* the x86 state of the thread; also reachable while a callback runs nested */
+static __thread struct vnhost_cpu *thread_cpu;
+
+/* set by NtCallbackReturn for the run loop of the innermost callback */
+struct callback_result
+{
+    BOOL     done;
+    void    *ret_ptr;
+    ULONG    ret_len;
+    NTSTATUS status;
+};
+static __thread struct callback_result *callback_result;
+
+
+extern void trace_syscall( UINT id, ULONG_PTR *args, ULONG len );
+extern void trace_sysret( UINT id, ULONG_PTR retval );
+extern void trace_usercall( UINT id, ULONG_PTR *args, ULONG len );
+extern void trace_userret( void *ret_ptr, ULONG len, NTSTATUS status, UINT id );
+
+static inline void context_init_xstate( CONTEXT *context, void *xstate_buffer )
+{
+    CONTEXT_EX *xctx = (CONTEXT_EX *)(context + 1);
+
+    xctx->Legacy.Length = sizeof(CONTEXT);
+    xctx->Legacy.Offset = -(LONG)sizeof(CONTEXT);
+    xctx->XState.Length = 25;
+    xctx->XState.Offset = 0;
+    xctx->All.Length = sizeof(CONTEXT) + 24;
+    xctx->All.Offset = -(LONG)sizeof(CONTEXT);
+}
+
+void wasm_cpuid( unsigned int ax, unsigned int cx, unsigned int *p )
+{
+    vnhost_cpuid( ax, cx, p );
+}
+
+
+/***********************************************************************
+ *           frame <-> cpu
+ */
+static void save_cpu_to_frame( struct vnhost_cpu *cpu, struct syscall_frame *frame, BOOL fpu )
+{
+    UINT r[R_COUNT];
+
+    vnhost_cpu_get( cpu, r );
+    frame->eax    = r[R_EAX];
+    frame->ecx    = r[R_ECX];
+    frame->edx    = r[R_EDX];
+    frame->ebx    = r[R_EBX];
+    frame->esp    = r[R_ESP];
+    frame->ebp    = r[R_EBP];
+    frame->esi    = r[R_ESI];
+    frame->edi    = r[R_EDI];
+    frame->eip    = r[R_EIP];
+    frame->eflags = r[R_EFLAGS];
+    frame->cs = SEL_CS;
+    frame->ss = frame->ds = frame->es = SEL_DS;
+    frame->fs = SEL_FS;
+    frame->gs = 0;
+    if (fpu)
+    {
+        vnhost_cpu_fxsave( cpu, &frame->u.xsave );
+        frame->xstate.Mask |= XSTATE_MASK_LEGACY;
+    }
+}
+
+/* load the guest state back after a syscall, as __wine_syscall_dispatcher_return does */
+static void restore_cpu_from_frame( struct vnhost_cpu *cpu, struct syscall_frame *frame, UINT eax )
+{
+    UINT r[R_COUNT], flags = frame->restore_flags;
+
+    vnhost_cpu_get( cpu, r );
+    if (flags & 0x68 /* CONTEXT_FLOATING_POINT | CONTEXT_EXTENDED_REGISTERS | CONTEXT_XSTATE */)
+        vnhost_cpu_fxrstor( cpu, &frame->u.xsave );
+    r[R_EDI] = frame->edi;
+    r[R_ESI] = frame->esi;
+    r[R_EBP] = frame->ebp;
+    r[R_EBX] = frame->ebx;
+    r[R_EAX] = eax;
+    if (flags & CONTEXT_INTEGER & 0xffff)
+    {
+        r[R_EAX] = frame->eax;
+        r[R_ECX] = frame->ecx;
+        r[R_EDX] = frame->edx;
+    }
+    if (flags & (CONTEXT_CONTROL | CONTEXT_SEGMENTS | CONTEXT_INTEGER) & 0xffff)
+        r[R_EFLAGS] = frame->eflags;
+    r[R_ESP] = frame->esp;
+    r[R_EIP] = frame->eip;
+    vnhost_cpu_set( cpu, r );
+}
+
+
+/***********************************************************************
+ *           dispatch_syscall
+ *
+ * The guest called a syscall thunk: "mov $id,%eax; call *dispatcher; ret $n".
+ */
+static void dispatch_syscall( struct thread_data *data, struct syscall_frame *frame, struct vnhost_cpu *cpu )
+{
+    SYSTEM_SERVICE_TABLE *table;
+    UINT r[R_COUNT], id, num, ret;
+    const ULONG *args;
+
+    vnhost_cpu_get( cpu, r );
+    save_cpu_to_frame( cpu, frame, TRUE );
+    frame->restore_flags = 0;
+    frame->eip = *(UINT *)r[R_ESP];          /* return address into the thunk */
+    frame->esp = r[R_ESP] + 4;
+    id = r[R_EAX];
+    args = (const ULONG *)(frame->esp + 4);  /* above the thunk's return address */
+
+    table = (SYSTEM_SERVICE_TABLE *)get_teb_data( data )->syscall_table + ((id >> 12) & 3);
+    num = id & 0xfff;
+    if (num >= table->ServiceLimit || !table->ServiceTable) ret = STATUS_INVALID_SYSTEM_SERVICE;
+    else
+    {
+        NTSTATUS (*func)( const ULONG * ) = (void *)table->ServiceTable[num];
+        if (get_teb_data( data )->syscall_trace) trace_syscall( id, (ULONG_PTR *)args, table->ArgumentTable[num] );
+        ret = func( args );
+        if (get_teb_data( data )->syscall_trace) trace_sysret( id, ret );
+    }
+    restore_cpu_from_frame( cpu, frame, ret );
+}
+
+
+/***********************************************************************
+ *           dispatch_unix_call
+ *
+ * __wine_unix_call( unixlib_handle_t handle, unsigned int code, void *args )
+ */
+static void dispatch_unix_call( struct thread_data *data, struct syscall_frame *frame, struct vnhost_cpu *cpu )
+{
+    UINT r[R_COUNT], ret;
+    const UINT *stack;
+    const unixlib_entry_t *funcs;
+
+    vnhost_cpu_get( cpu, r );
+    save_cpu_to_frame( cpu, frame, FALSE );
+    frame->restore_flags = RESTORE_FLAGS_INCOMPLETE_FRAME_CONTEXT;
+    stack = (const UINT *)r[R_ESP];
+    frame->eip = stack[0];
+    frame->esp = r[R_ESP] + 0x10;           /* stdcall: handle (8 bytes), code, args */
+    funcs = (const unixlib_entry_t *)(ULONG_PTR)stack[1];
+    if (funcs) ret = funcs[stack[3]]( (void *)(ULONG_PTR)stack[4] );
+    else
+    {
+        WARN( "unix call %u without a unix library\n", stack[3] );
+        ret = STATUS_DLL_NOT_FOUND;
+    }
+    restore_cpu_from_frame( cpu, frame, ret );
+}
+
+
+/***********************************************************************
+ *           raise_guest_exception
+ *
+ * The x86 core stopped on a fault: hand it to KiUserExceptionDispatcher.
+ */
+static void raise_guest_exception( struct thread_data *data, struct syscall_frame *frame,
+                                   struct vnhost_cpu *cpu, int exit, const UINT *info )
+{
+    EXCEPTION_RECORD rec = { 0 };
+    CONTEXT context = { CONTEXT_FULL | CONTEXT_FLOATING_POINT | CONTEXT_EXTENDED_REGISTERS };
+    NTSTATUS status;
+
+    save_cpu_to_frame( cpu, frame, TRUE );
+    frame->restore_flags = 0;
+    NtGetContextThread( GetCurrentThread(), &context );
+
+    rec.ExceptionAddress = (void *)frame->eip;
+    switch (exit)
+    {
+    case VNHOST_FAULT:
+        rec.ExceptionCode = STATUS_ACCESS_VIOLATION;
+        rec.NumberParameters = 2;
+        rec.ExceptionInformation[0] = info[1] ? EXCEPTION_WRITE_FAULT : EXCEPTION_READ_FAULT;
+        rec.ExceptionInformation[1] = info[0];
+        break;
+    case VNHOST_DIVIDE:
+        rec.ExceptionCode = EXCEPTION_INT_DIVIDE_BY_ZERO;
+        break;
+    case VNHOST_INT:
+        if (info[0] == 3)
+        {
+            rec.ExceptionCode = EXCEPTION_BREAKPOINT;
+            rec.NumberParameters = 1;
+            rec.ExceptionAddress = (char *)rec.ExceptionAddress - 1;
+            break;
+        }
+        if (info[0] == 0x2d)
+        {
+            rec.ExceptionCode = EXCEPTION_BREAKPOINT;
+            rec.NumberParameters = 1;
+            rec.ExceptionInformation[0] = context.Eax;
+            break;
+        }
+        if (info[0] == 0x29) /* __fastfail */
+        {
+            rec.ExceptionCode = STATUS_STACK_BUFFER_OVERRUN;
+            rec.ExceptionFlags = EXCEPTION_NONCONTINUABLE;
+            rec.NumberParameters = 1;
+            rec.ExceptionInformation[0] = context.Ecx;
+            break;
+        }
+        rec.ExceptionCode = STATUS_ACCESS_VIOLATION;
+        rec.NumberParameters = 2;
+        rec.ExceptionInformation[1] = 0xffffffff;
+        break;
+    case VNHOST_HALT:
+        rec.ExceptionCode = STATUS_PRIVILEGED_INSTRUCTION;
+        break;
+    default:
+        rec.ExceptionCode = EXCEPTION_ILLEGAL_INSTRUCTION;
+        break;
+    }
+
+    status = send_debug_event( data, &rec, &context, TRUE );
+    if (status == DBG_CONTINUE || status == DBG_EXCEPTION_HANDLED)
+    {
+        NtSetContextThread( GetCurrentThread(), &context );
+        restore_cpu_from_frame( cpu, frame, frame->eax );
+        return;
+    }
+    call_user_exception_dispatcher( data, &rec, &context );
+    frame->restore_flags |= CONTEXT_CONTROL;
+    restore_cpu_from_frame( cpu, frame, frame->eax );
+}
+
+
+/***********************************************************************
+ *           handle_pending_signals
+ *
+ * Signals sent to this thread (by wineserver or other threads) are noticed between blocks.
+ */
+static void handle_pending_signals( struct syscall_frame *frame, struct vnhost_cpu *cpu )
+{
+    if (vnhost_signal_pending( SIGUSR1 ))
+    {
+        CONTEXT context = { CONTEXT_FULL | CONTEXT_FLOATING_POINT | CONTEXT_EXTENDED_REGISTERS };
+
+        save_cpu_to_frame( cpu, frame, TRUE );
+        frame->restore_flags = 0;
+        NtGetContextThread( GetCurrentThread(), &context );
+        wait_suspend( &context );
+        NtSetContextThread( GetCurrentThread(), &context );
+        frame->restore_flags |= CONTEXT_FULL;
+        restore_cpu_from_frame( cpu, frame, frame->eax );
+    }
+    if (vnhost_signal_pending( SIGQUIT )) abort_thread( 0 );
+}
+
+
+/***********************************************************************
+ *           run_guest
+ *
+ * Runs PE code from the state in the frame until a callback returns (if one is active).
+ */
+static void run_guest( struct thread_data *data, struct callback_result *result )
+{
+    struct vnhost_cpu *cpu = thread_cpu;
+    UINT info[2];
+
+    restore_cpu_from_frame( cpu, get_syscall_frame( data ), get_syscall_frame( data )->eax );
+    for (;;)
+    {
+        struct syscall_frame *frame = get_syscall_frame( data );
+        int exit = vnhost_cpu_run( cpu, info );
+
+        switch (exit)
+        {
+        case VNHOST_TRAP:
+            if (info[0] == WASM_SYSCALL_TRAP) dispatch_syscall( data, frame, cpu );
+            else if (info[0] == WASM_UNIXCALL_TRAP) dispatch_unix_call( data, frame, cpu );
+            else raise_guest_exception( data, frame, cpu, VNHOST_FAULT, info );
+            break;
+        case VNHOST_PENDING:
+            handle_pending_signals( frame, cpu );
+            break;
+        default:
+            raise_guest_exception( data, frame, cpu, exit, info );
+            break;
+        }
+        if (result && result->done) return;
+    }
+}
+
+
+/***********************************************************************
+ *           signal_set_full_context
+ */
+NTSTATUS signal_set_full_context( CONTEXT *context )
+{
+    NTSTATUS status = NtSetContextThread( GetCurrentThread(), context );
+
+    if (!status && (context->ContextFlags & CONTEXT_INTEGER) == CONTEXT_INTEGER)
+        get_syscall_frame(get_thread_data())->restore_flags |= LOWORD(CONTEXT_INTEGER);
+    return status;
