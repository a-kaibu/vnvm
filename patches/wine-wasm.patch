+/***********************************************************************
+ *           init_syscall_frame
+ */
+static void init_syscall_frame( PRTL_THREAD_START_ROUTINE entry, void *arg, TEB *teb )
+{
+    struct thread_data *data = get_thread_data();
+    struct syscall_frame *frame = get_syscall_frame( data );
+    CONTEXT *ctx, context = { CONTEXT_ALL };
+    DWORD *stack;
+
+    context.SegCs  = SEL_CS;
+    context.SegDs  = SEL_DS;
+    context.SegEs  = SEL_DS;
+    context.SegFs  = SEL_FS;
+    context.SegGs  = 0;
+    context.SegSs  = SEL_DS;
+    context.EFlags = 0x202;
+    context.Eax    = (DWORD)entry;
+    context.Ebx    = (DWORD)arg;
+    context.Esp    = (DWORD)teb->Tib.StackBase - 16;
+    context.Eip    = (DWORD)pRtlUserThreadStart;
+    context.FloatSave.ControlWord = 0x27f;
+    ((XSAVE_FORMAT *)context.ExtendedRegisters)->ControlWord = 0x27f;
+    ((XSAVE_FORMAT *)context.ExtendedRegisters)->MxCsr = 0x1f80;
+    if ((ctx = get_cpu_area( data, IMAGE_FILE_MACHINE_I386 ))) *ctx = context;
+
+    if (data->suspend)
+    {
+        context.ContextFlags |= CONTEXT_EXCEPTION_REPORTING | CONTEXT_EXCEPTION_ACTIVE;
+        wait_suspend( &context );
+    }
+
+    ctx = (CONTEXT *)((ULONG_PTR)context.Esp & ~3) - 1;
+    *ctx = context;
+    ctx->ContextFlags = CONTEXT_FULL | CONTEXT_FLOATING_POINT | CONTEXT_EXTENDED_REGISTERS;
+    memset( &frame->xstate, 0, sizeof(frame->xstate) );
+    signal_set_full_context( ctx );
+
+    stack = (DWORD *)ctx;
+    *(--stack) = 0;
+    *(--stack) = 0;
+    *(--stack) = 0;
+    *(--stack) = (DWORD)ctx;
+    *(--stack) = 0xdeadbabe;
+    frame->esp = (DWORD)stack;
+    frame->eip = (DWORD)pLdrInitializeThunk;
+    frame->restore_flags |= CONTEXT_CONTROL | CONTEXT_INTEGER | CONTEXT_EXTENDED_REGISTERS;
+
+    pthread_sigmask( SIG_UNBLOCK, &server_block_set, NULL );
+}
+
+
+/***********************************************************************
+ *           signal_start_thread
+ */
+void DECLSPEC_NORETURN signal_start_thread( PRTL_THREAD_START_ROUTINE entry, void *arg, TEB *teb )
+{
+    struct thread_data *data = get_thread_data();
+    struct teb_data *teb_data = get_teb_data( data );
+    void *buffer = NULL;
+
+    if (!teb_data->syscall_frame)
+    {
+        buffer = malloc( frame_size + 63 );
+        teb_data->syscall_frame = (void *)(((ULONG_PTR)buffer + 63) & ~63);
+        memset( teb_data->syscall_frame, 0, sizeof(struct syscall_frame) );
+    }
+    thread_cpu = vnhost_cpu_create( WASM_SYSCALL_TRAP, WASM_TRAP_END );
+    vnhost_cpu_set_fs( thread_cpu, (UINT)(ULONG_PTR)teb );
+
+    init_syscall_frame( entry, arg, teb );
+    run_guest( data, NULL );
+    abort();
+}
